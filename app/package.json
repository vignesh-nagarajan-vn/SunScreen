{
  "name": "sunscreen",
  "version": "1.0.0",
  "main": "index.js",
  "private": true,
  "scripts": {
    "test": "node --test tests/*.test.cjs",
    "start": "expo start",
    "android:apk": "npx eas-cli@latest build --platform android --profile preview",
    "android:store": "npx eas-cli@latest build --platform android --profile production",
    "eas-build-post-install": "node scripts/check-android-build.cjs",
    "export:web": "expo export --platform web --output-dir ../dist",
    "test:web": "playwright test",
    "test:urls": "node --test tests/mapUrls.test.cjs"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.15",
    "@react-native-community/slider": "5.2.1",
    "expo": "~58.0.19",
    "expo-build-properties": "~58.0.11",
    "expo-constants": "~58.0.13",
    "expo-location": "~58.0.19",
    "leaflet": "1.9.4",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.0",
    "react-native-maps": "1.29.11",
    "react-native-svg": "15.16.0",
    "react-native-web": "^0.21.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1"
  }
}
